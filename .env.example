# Configuración de variables de entorno para el sistema de contacto
# Copia este archivo a .env y llena los valores

# Gmail
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASS=tu-contraseña-app-gmail

# Puerto del servidor
PORT=3000

# Para obtener la contraseña de aplicación de Gmail:
# 1. Ve a myaccount.google.com/security
# 2. Activa Verificación en dos pasos
# 3. Ve a "Contraseñas de aplicación"
# 4. Selecciona "Correo" y "Windows (o tu dispositivo)"
# 5. Copia la contraseña generada
